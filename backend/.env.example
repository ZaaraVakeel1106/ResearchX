# Comma-separated browser origins allowed to call the API.
RESEARCH_X_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local PostgreSQL connection. Replace the placeholder password in your ignored .env.
RESEARCH_X_DATABASE_URL=postgresql+psycopg://research_x:replace_me@localhost:5432/research_x

# OpenAlex Works API. The URL is public; the optional key stays in this backend-only file.
RESEARCH_X_OPENALEX_BASE_URL=https://api.openalex.org
RESEARCH_X_OPENALEX_API_KEY=
